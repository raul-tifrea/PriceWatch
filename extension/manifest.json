{
  "manifest_version": 3,
  "name": "PriceWatch",
  "version": "1.0.0",
  "description": "Track product prices on cel.ro, pcgarage.ro, and altex.ro directly from the product page.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.cel.ro/*",
        "*://*.pcgarage.ro/*",
        "*://*.altex.ro/*"
      ],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:5173/*"],
      "js": ["dashboard_bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://localhost:5173/*"
  ]
}
